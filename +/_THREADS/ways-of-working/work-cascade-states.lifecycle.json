{
  "schema_version": 3,
  "diagram_type": "lifecycle",
  "meta": {
    "title": "A conversation's headline \u00b7 who holds it, derived from where its work lies",
    "output": "work-cascade-states.html",
    "animation": "none",
    "quality_profile": "showcase"
  },
  "mainPath": [
    "opened",
    "with_agent",
    "sent_you",
    "with_you",
    "finished"
  ],
  "states": [
    {
      "id": "opened",
      "type": "start",
      "label": "Opened",
      "sublabel": "opener or send line",
      "tag": "entry"
    },
    {
      "id": "with_agent",
      "type": "active",
      "label": "With agent",
      "sublabel": "any item held by a run",
      "tag": "heartbeat"
    },
    {
      "id": "sent_you",
      "type": "waiting",
      "label": "Sent to you",
      "sublabel": "no run holds work; unread",
      "tag": "since"
    },
    {
      "id": "with_you",
      "type": "decision",
      "label": "With you",
      "sublabel": "received; yours to move",
      "tag": "since"
    },
    {
      "id": "finished",
      "type": "success",
      "label": "Finished",
      "sublabel": "close-out done",
      "tag": "terminal"
    },
    {
      "id": "sent_agent",
      "type": "waiting",
      "label": "Sent to agent",
      "sublabel": "reply not yet taken up",
      "tag": "flag if old"
    }
  ],
  "transitions": [
    {
      "id": "open",
      "from": "opened",
      "to": "with_agent",
      "label": "receive"
    },
    {
      "id": "send-you",
      "from": "with_agent",
      "to": "sent_you",
      "label": "last run ends: send"
    },
    {
      "id": "receive-you",
      "from": "sent_you",
      "to": "with_you",
      "label": "with me"
    },
    {
      "id": "finish",
      "from": "with_you",
      "to": "finished",
      "label": "close"
    },
    {
      "id": "send-agent",
      "from": "with_you",
      "to": "sent_agent",
      "label": "reply: send",
      "variant": "dashed"
    },
    {
      "id": "pass",
      "from": "sent_you",
      "to": "sent_agent",
      "label": "reply: pass through",
      "variant": "dashed"
    },
    {
      "id": "receive-agent",
      "from": "sent_agent",
      "to": "with_agent",
      "label": "turn starts: receive"
    }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "Derived, except one bit",
      "items": [
        "With agent while any item is held by a run; otherwise sent to you",
        "Only your receive, with me, is not derivable from the work"
      ]
    },
    {
      "dot": "amber",
      "title": "Items keep their own holders",
      "items": [
        "A query can be with you while runs keep the headline With agent",
        "The facts line under the headline counts items by holder"
      ]
    }
  ]
}
