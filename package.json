{
  "name": "@knowledgeislands/ki-principal",
  "description": "The core knowledge repository of the Knowledge Islands project - governance base, evolving KB, and decision record.",
  "version": "1.0.0",
  "author": "kris@kris.me.uk",
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/node": "^26.6.5",
    "knip": "^6.42.0",
    "lint-staged": "^17.6.0",
    "rumdl": "^0.3.0",
    "syncpack": "^15.3.3",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  },
  "homepage": "https://github.com/knowledgeislands/ki-principal#readme",
  "keywords": [
    "knowledge-base",
    "knowledge-islands",
    "markdown"
  ],
  "license": "MIT",
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,jsonc}": [
      "biome check --write --no-errors-on-unmatched"
    ],
    "*.md": [
      "rumdl check --fix"
    ]
  },
  "packageManager": "bun@1.4.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/knowledgeislands/ki-principal.git"
  },
  "scripts": {
    "clean": "rm -rf node_modules",
    "ki:deps:update": "bun update --latest",
    "prepare": "git config core.hooksPath .githooks"
  },
  "type": "module"
}
