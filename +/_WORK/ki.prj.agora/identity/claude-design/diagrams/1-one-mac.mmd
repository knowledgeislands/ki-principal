---
config:
  layout: elk
---
%% Agora on one Mac: agents joining, local messaging, and how each kind of agent is woken.
%% Read left to right. Solid lines work today. Dashed lines are the target or a gap.
%% Colours are ki-design tokens (light). Render: see README.md in this folder.
flowchart LR
  subgraph WHO["Who starts it"]
    HH["The household agent<br/>adds a work package<br/>to the watch list"]:::agent
    SEND["An agent with<br/>something to say"]:::agent
    KRIS(["Kris, at the menu bar"]):::kris
  end

  subgraph GIT["Git on this Mac: durable"]
    MSG[("messages.md<br/>the owner's inbox,<br/>in its work package")]:::git
  end

  subgraph AG["Agora on this Mac: conversational"]
    JOIN[("Watch list<br/>who has joined")]:::agora
    WATCH["Watch<br/>sees each commit<br/>as it lands"]:::agora
    BCF[("Broadcasts<br/>one file per agent")]:::agora
    CALL[("Agora's call<br/>one file per agent")]:::agora
    WAKE["Waker<br/>types one fixed line,<br/>only between turns"]:::agora
    NOTE["Notify Kris"]:::target
  end

  subgraph RECV["Agents, by how each is woken"]
    CC["Claude Code<br/>in an Orca chat or a terminal<br/><i>waits on its own call</i>"]:::agent
    OT["Claude Code or Codex<br/>in an Orca terminal<br/><i>woken by Agora's line</i>"]:::agent
    OC["Codex in an Orca chat<br/><i>no way in yet</i>"]:::gap
    CD["Claude Desktop, Claude Design<br/><i>read their inbox when opened</i>"]:::agent
  end

  ACK[("Answers<br/>heard or silent,<br/>shown in Kris's tray")]:::agora

  HH -- "joins it" --> JOIN
  JOIN --> WATCH
  SEND -- "adds a line,<br/>commits" --> MSG
  MSG -- "the commit lands" --> WATCH
  SEND -. "quick message,<br/>no commit (target)" .-> CALL
  KRIS -- "Broadcast, Away,<br/>I'm back, Ping, Mark all" --> BCF
  WATCH -- "a new line" --> CALL
  BCF --> CALL
  CALL -- "the wait ends" --> CC
  CALL --> WAKE
  WAKE -- "orca terminal send" --> OT
  WAKE -. "waits for<br/>Orca chat send" .-> OC
  CALL -. "cannot wake it" .-> NOTE
  NOTE -. "Kris opens it" .-> CD
  CC -- "answers" --> ACK
  OT -- "answers" --> ACK
  CD -. "answers when opened" .-> ACK

  classDef kris fill:#1b3a5c,stroke:#1b3a5c,color:#f5efe0,stroke-width:1.5px
  classDef agent fill:#f5efe0,stroke:#1b3a5c,color:#1a2030,stroke-width:1.5px
  classDef agora fill:#f5efe0,stroke:#317070,color:#1a2030,stroke-width:1.5px
  classDef git fill:#ddddcc,stroke:#2d5a3d,color:#1a2030,stroke-width:1.5px
  classDef target fill:#f1e8d3,stroke:#8a5a12,color:#1a2030,stroke-width:1.5px,stroke-dasharray:5 4
  classDef gap fill:#ead8c8,stroke:#9b2c1c,color:#1a2030,stroke-width:1.5px,stroke-dasharray:5 4
  style WHO fill:#f5efe0,stroke:#d4c9b4,color:#4a5568
  style GIT fill:#eef1f5,stroke:#2d5a3d,color:#2d5a3d
  style AG fill:#eef1f5,stroke:#317070,color:#317070
  style RECV fill:#eef1f5,stroke:#d4c9b4,color:#4a5568
